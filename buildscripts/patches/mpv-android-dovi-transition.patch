index f93f6cf979..d9aa7ab9ba 100644
--- a/video/out/vo.c
+++ b/video/out/vo.c
@@ -1288,6 +1288,37 @@ void vo_seek_reset(struct vo *vo)
     mp_mutex_unlock(&in->lock);
 }
 
+static void prepare_decoder_reset(void *arg)
+{
+    void **args = arg;
+    struct vo *vo = args[0];
+    bool *prepared = args[1];
+    // Only the direct Android Dolby Vision path has the one-shot Surface
+    // buffers addressed here. Leave other backends and ordinary video alone.
+    if (strcmp(vo->driver->name, "gpu-next") || !vo->params ||
+        vo->params->imgfmt != IMGFMT_MEDIACODEC ||
+        vo->params->repr.sys != PL_COLOR_SYSTEM_DOLBYVISION)
+        return;
+
+    struct vo_internal *in = vo->in;
+    mp_mutex_lock(&in->lock);
+    forget_frames(vo);
+    reset_vsync_timings(vo);
+    mp_mutex_unlock(&in->lock);
+    vo->driver->control(vo, VOCTRL_RESET, NULL);
+    *prepared = true;
+    MP_DBG(vo, "Prepared Dolby Vision Surface queue before decoder reset\n");
+}
+
+bool vo_prepare_decoder_reset(struct vo *vo)
+{
+    bool prepared = false;
+    void *args[] = {vo, &prepared};
+    if (vo)
+        mp_dispatch_run(vo->in->dispatch, prepare_decoder_reset, args);
+    return prepared;
+}
