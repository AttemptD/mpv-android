+/* This output mode presents the compatible HDR base signal, not Dolby-processed
+ * pixels. Keep its transfer and static metadata explicit on the codec Surface. */
+static int mediacodec_set_native_hdr(AVCodecContext *avctx,
+                                    MediaCodecH264DecContext *s,
+                                    FFAMediaFormat *format)
+{
+    uint8_t hdr[25] = {0};
+    int have_hdr = 0;
+    const AVPacketSideData *sd;
+    if (s->native_hdr_output != AVCOL_TRC_SMPTEST2084 &&
+        s->native_hdr_output != AVCOL_TRC_ARIB_STD_B67)
+        return AVERROR(EINVAL);
+    if (avctx->color_trc == AVCOL_TRC_UNSPECIFIED)
+        avctx->color_trc = s->native_hdr_output;
+    if (s->native_dolby_vision || avctx->color_trc != s->native_hdr_output) {
+        av_log(avctx, AV_LOG_ERROR, "Native HDR input transfer %d does not match requested %d\n",
+               avctx->color_trc, s->native_hdr_output);
+        return AVERROR(EINVAL);
+    }
+#if CONFIG_HEVC_MEDIACODEC_DECODER
+    if (avctx->codec_id == AV_CODEC_ID_HEVC && s->dovi_ctx.cfg.dv_profile) {
+        const AVDOVIDecoderConfigurationRecord *cfg = &s->dovi_ctx.cfg;
+        if (cfg->dv_profile != 8 || cfg->el_present_flag || !cfg->bl_present_flag ||
+            cfg->dv_bl_signal_compatibility_id != (s->native_hdr_output == 16 ? 1 : 4)) {
+            av_log(avctx, AV_LOG_ERROR, "Native HDR requires a compatible P8 base layer\n");
+            return AVERROR(EINVAL);
+        }
+        avctx->profile = AV_PROFILE_HEVC_MAIN_10;
+    }
+#endif
+    ff_AMediaFormat_setInt32(format, "color-transfer",
+        ff_AMediaFormatColorTransfer_from_AVColorTransfer(avctx->color_trc));
+    if (avctx->color_primaries == AVCOL_PRI_BT2020)
+        ff_AMediaFormat_setInt32(format, "color-standard", 6);
+    else if (avctx->color_primaries == AVCOL_PRI_BT709)
+        ff_AMediaFormat_setInt32(format, "color-standard", 1);
+    if (avctx->color_range != AVCOL_RANGE_UNSPECIFIED)
+        ff_AMediaFormat_setInt32(format, "color-range",
+            ff_AMediaFormatColorRange_from_AVColorRange(avctx->color_range));
+    sd = ff_get_coded_side_data(avctx, AV_PKT_DATA_MASTERING_DISPLAY_METADATA);
+    if (sd && sd->size >= sizeof(AVMasteringDisplayMetadata)) {
+        const AVMasteringDisplayMetadata *md = (const void *)sd->data;
+        if (md->has_primaries) {
+            for (int i = 0; i < 3; i++)
+                for (int j = 0; j < 2; j++)
+                    AV_WL16(hdr + 1 + 4*i + 2*j,
+                        lrint(av_clipd(av_q2d(md->display_primaries[i][j])*50000, 0, 65535)));
+            for (int j = 0; j < 2; j++)
+                AV_WL16(hdr + 13 + 2*j,
+                    lrint(av_clipd(av_q2d(md->white_point[j])*50000, 0, 65535)));
+        }
+        if (md->has_luminance) {
+            AV_WL16(hdr + 17, lrint(av_clipd(av_q2d(md->max_luminance), 0, 65535)));
+            AV_WL16(hdr + 19, lrint(av_clipd(av_q2d(md->min_luminance)*10000, 0, 65535)));
+        }
+        have_hdr = md->has_primaries || md->has_luminance;
+    }
+    sd = ff_get_coded_side_data(avctx, AV_PKT_DATA_CONTENT_LIGHT_LEVEL);
+    if (sd && sd->size >= sizeof(AVContentLightMetadata)) {
+        const AVContentLightMetadata *cl = (const void *)sd->data;
+        AV_WL16(hdr + 21, FFMIN(cl->MaxCLL, 65535));
+        AV_WL16(hdr + 23, FFMIN(cl->MaxFALL, 65535));
+        have_hdr = 1;
+    }
+    if (have_hdr)
+        ff_AMediaFormat_setBuffer(format, "hdr-static-info", hdr, sizeof(hdr));
+    av_log(avctx, AV_LOG_INFO, "Native HDR Surface requested: %s\n",
+           s->native_hdr_output == 16 ? "HDR10/PQ" : "HLG");
+    return 0;
+}
+
+#if CONFIG_HEVC_MEDIACODEC_DECODER
+static int mediacodec_hdr_base_packet(AVCodecContext *avctx,
+                                      MediaCodecH264DecContext *s, AVPacket *pkt)
+{
+    AVPacket base = {0};
+    int ret, bytes = 0, removed = 0;
+    mediacodec_dovi_update_config(avctx, s, pkt);
+    if (!s->dovi_ctx.cfg.dv_profile)
+        return 0;
+    if (s->dovi_ctx.cfg.dv_profile != 8 || s->dovi_ctx.cfg.el_present_flag ||
+        s->dovi_ctx.cfg.dv_bl_signal_compatibility_id != (s->native_hdr_output == 16 ? 1 : 4))
+        return AVERROR_INVALIDDATA;
+    ret = ff_h2645_packet_split(&s->dovi_pkt, pkt->data, pkt->size, avctx, 4,
+                               AV_CODEC_ID_HEVC, H2645_FLAG_SMALL_PADDING);
+    if (ret < 0)
+        return ret;
+    for (int i = 0; i < s->dovi_pkt.nb_nals; i++) {
+        H2645NAL *n = &s->dovi_pkt.nals[i];
+        if (n->nuh_layer_id)
+            return AVERROR_INVALIDDATA;
+        if (n->type == 62) { removed++; continue; }
+        if (n->raw_size > INT_MAX - bytes - 4)
+            return AVERROR(ENOMEM);
+        bytes += 4 + n->raw_size;
+    }
+    if (!removed)
+        return 0;
+    if ((ret = av_new_packet(&base, bytes)) < 0)
+        return ret;
+    if ((ret = av_packet_copy_props(&base, pkt)) < 0) {
+        av_packet_unref(&base);
+        return ret;
+    }
+    bytes = 0;
+    for (int i = 0; i < s->dovi_pkt.nb_nals; i++) {
+        H2645NAL *n = &s->dovi_pkt.nals[i];
+        if (n->type == 62) continue;
+        AV_WB32(base.data + bytes, 1);
+        memcpy(base.data + bytes + 4, n->raw_data, n->raw_size);
+        bytes += 4 + n->raw_size;
+    }
+    av_packet_unref(pkt);
+    av_packet_move_ref(pkt, &base);
+    if (!s->dovi_metadata_logged) {
+        av_log(avctx, AV_LOG_INFO, "P8 native HDR: removed Dolby RPU NAL units; compatible base video retained\n");
+        s->dovi_metadata_logged = 1;
+    }
+    return 0;
+}
+#endif
