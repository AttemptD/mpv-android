+#if CONFIG_HEVC_MEDIACODEC_DECODER
+    /* MediaCodec does not parse HEVC Dolby Vision NAL units itself. Keep a
+     * lightweight side parser and join the resulting metadata back to output
+     * frames by the presentation timestamp passed through MediaCodec. */
+    DOVIContext dovi_ctx;
+    H2645Packet dovi_pkt;
+    MediaCodecDoviFrame *dovi_frames;
+    int nb_dovi_frames;
+    int dovi_metadata_logged;
