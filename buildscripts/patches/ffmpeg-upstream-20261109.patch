+/*
+ * libsmb2 support by proconsule
+ * based on libsmbclient.c by Lukasz Marek <lukasz.m.luki@gmail.com>
+ */
+
+#include <errno.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <fcntl.h>
+#include <string.h>
+#include <time.h>
+#include <smb2/smb2.h>
+#include <smb2/libsmb2.h>
+#include <smb2/libsmb2-raw.h>
+#include "libavutil/avstring.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "avformat.h"
+#include "internal.h"
+#include "url.h"
+#include "urldecode.h"
+
+#define LIBSMB_MAX_CONNECTIONS 4
+
+typedef struct {
+    const AVClass *class;
+    struct smb2_context *smb2;
+    struct smb2fh *fh;
+    struct smb2dir *dir;
+    struct smb2_url *url;
+    char *decoded_share;
+    char *decoded_path;
+    char *decoded_user;
+    int connected;
+    struct smb2_context *aux_smb2[LIBSMB_MAX_CONNECTIONS - 1];
+    struct smb2fh *aux_fh[LIBSMB_MAX_CONNECTIONS - 1];
+    struct smb2_url *aux_url[LIBSMB_MAX_CONNECTIONS - 1];
+    char *auth;
+    int64_t filesize;
+    int64_t position;
+    int64_t read_buffer_start;
+    unsigned char *read_buffer;
+    int read_buffer_size;
+    int read_buffer_valid;
+    int64_t delivered_bytes;
+    int64_t fetched_bytes;
+    int prefetch_count;
+    int trunc;
+    int timeout;
+    char *workgroup;
+} LIBSMBContext;
+
+typedef struct {
+    const char *url;
+    const char *auth;
+    struct smb2_context *smb2;
+    struct smb2fh *fh;
+    struct smb2_url *parsed_url;
+    int connected;
+    int result;
+} LIBSMBOpenTask;
+
+typedef struct {
+    struct smb2_context *smb2;
+    struct smb2fh *fh;
+    unsigned char *buffer;
+    uint32_t size;
+    uint64_t offset;
+    int result;
+} LIBSMBParallelReadTask;
+
+static void libsmbc_close_connection(struct smb2_context **smb2,
+                                     struct smb2fh **fh,
+                                     struct smb2_url **url,
+                                     int connected)
+{
+    if (*fh && *smb2)
+        smb2_close(*smb2, *fh);
+    *fh = NULL;
+    if (*url)
+        smb2_destroy_url(*url);
+    *url = NULL;
+    if (*smb2) {
+        if (connected)
+            smb2_disconnect_share(*smb2);
+        smb2_destroy_context(*smb2);
+    }
+    *smb2 = NULL;
+}
+
+static void *libsmbc_open_worker(void *opaque)
+{
+    LIBSMBOpenTask *task = opaque;
+    char *share = NULL;
+    char *path = NULL;
+    char *user = NULL;
+
+    task->result = AVERROR(EIO);
+    task->smb2 = smb2_init_context();
+    if (!task->smb2) {
+        task->result = AVERROR(ENOMEM);
+        return NULL;
+    }
+    smb2_set_timeout(task->smb2, 30);
+    smb2_set_password(task->smb2, task->auth ? task->auth : "");
+    smb2_set_security_mode(task->smb2, SMB2_NEGOTIATE_SIGNING_ENABLED);
+    task->parsed_url = smb2_parse_url(task->smb2, task->url);
+    if (!task->parsed_url)
+        goto fail;
+    share = ff_urldecode(task->parsed_url->share ? task->parsed_url->share : "", 0);
+    path = ff_urldecode(task->parsed_url->path ? task->parsed_url->path : "", 0);
+    user = ff_urldecode(task->parsed_url->user ? task->parsed_url->user : "", 0);
+    if (!share || !path || !user) {
+        task->result = AVERROR(ENOMEM);
+        goto fail;
+    }
+    if (smb2_connect_share(task->smb2, task->parsed_url->server,
+                           share, user) != 0)
+        goto fail;
+    task->connected = 1;
+    task->fh = smb2_open(task->smb2, path, O_RDONLY);
+    if (!task->fh)
+        goto fail;
+
+    av_free(share);
+    av_free(path);
+    av_free(user);
+    task->result = 0;
+    return NULL;
+
+fail:
+    av_free(share);
+    av_free(path);
+    av_free(user);
+    libsmbc_close_connection(&task->smb2, &task->fh, &task->parsed_url,
+                             task->connected);
+    return NULL;
+}
+
+static void *libsmbc_parallel_read_worker(void *opaque)
+{
+    LIBSMBParallelReadTask *task = opaque;
+    uint32_t total = 0;
+    uint32_t server_limit = smb2_get_max_read_size(task->smb2);
+
+    if (!server_limit)
+        server_limit = 64U * 1024U;
+    if (smb2_get_dialect(task->smb2) == SMB2_VERSION_0202)
+        server_limit = FFMIN(server_limit, 64U * 1024U);
+
+    while (total < task->size) {
+        uint32_t request = FFMIN(server_limit, task->size - total);
+        int ret = smb2_pread(task->smb2, task->fh, task->buffer + total,
+                             request, task->offset + total);
+        if (ret < 0) {
+            task->result = total ? total : ret;
+            return NULL;
+        }
+        if (!ret)
+            break;
+        total += ret;
+        if ((uint32_t)ret < request)
+            break;
+    }
+
+    task->result = total;
+    return NULL;
+}
+
+typedef struct {
+    uint32_t requested;
+    int status;
+    int finished;
+} LIBSMBReadPart;
+
+static void libsmbc_read_callback(struct smb2_context *smb2, int status,
+                                  void *command_data, void *callback_data)
+{
+    LIBSMBReadPart *part = callback_data;
+
+    (void)smb2;
+    (void)command_data;
+    part->status = status;
+    part->finished = 1;
+}
+
+static int libsmbc_abort_async_read(LIBSMBContext *libsmbc,
+                                    LIBSMBReadPart *parts, int error)
+{
+    /* Destroying a context synchronously aborts its outstanding callbacks. */
+    smb2_destroy_context(libsmbc->smb2);
+    libsmbc->smb2 = NULL;
+    libsmbc->connected = 0;
+    libsmbc->fh = NULL;
+    libsmbc->dir = NULL;
+    av_free(parts);
+    return error;
+}
+
+/*
+ * libsmb2's synchronous read API turns every small FFmpeg URL read into a
+ * separate network round trip. Queue all server-sized pieces of one read at
+ * once instead. This is especially important for SMB 2.0.2, whose requests
+ * are limited to 64 KiB.
+ */
+static int libsmbc_pipelined_pread(URLContext *h, unsigned char *buf, int size,
+                                   int64_t offset)
+{
+    LIBSMBContext *libsmbc = h->priv_data;
+    uint32_t max_read_size = smb2_get_max_read_size(libsmbc->smb2);
+    uint32_t dialect_limit = smb2_get_dialect(libsmbc->smb2) == SMB2_VERSION_0202
+                           ? 64U * 1024U : 1024U * 1024U;
+    uint32_t server_limit;
+    uint32_t pipeline_target;
+    uint32_t segment_size;
+
+    if (!max_read_size)
+        max_read_size = 64U * 1024U;
+    server_limit = FFMIN(dialect_limit, max_read_size);
+    /* Keep at least four reads in flight on modern SMB, like Exo's workers. */
+    pipeline_target = FFMAX(64U * 1024U, (size + 3U) / 4U);
+    segment_size = FFMIN(server_limit, pipeline_target);
+    int part_count = (size + segment_size - 1) / segment_size;
+    LIBSMBReadPart *parts = av_calloc(part_count, sizeof(*parts));
+    int scheduled = 0;
+    int scheduling_error = 0;
+    int idle_seconds = 0;
+    int total = 0;
+
+    if (!parts)
+        return AVERROR(ENOMEM);
+
+    for (int index = 0; index < part_count; index++) {
+        int part_offset = index * segment_size;
+        uint32_t part_length = FFMIN(segment_size, size - part_offset);
+        int ret;
+
+        parts[index].requested = part_length;
+        ret = smb2_pread_async(libsmbc->smb2, libsmbc->fh,
+                               buf + part_offset, part_length,
+                               offset + part_offset, libsmbc_read_callback,
+                               &parts[index]);
+        if (ret < 0) {
+            scheduling_error = ret;
+            break;
+        }
+        scheduled++;
+    }
+
+    while (scheduled > 0) {
+        int completed = 1;
+        struct pollfd descriptor;
+        int poll_result;
+        int service_result;
+
+        for (int index = 0; index < scheduled; index++) {
+            if (!parts[index].finished) {
+                completed = 0;
+                break;
+            }
+        }
+        if (completed)
+            break;
+
+        descriptor.fd = smb2_get_fd(libsmbc->smb2);
+        descriptor.events = smb2_which_events(libsmbc->smb2);
+        descriptor.revents = 0;
+        if (descriptor.fd < 0) {
+            av_log(h, AV_LOG_ERROR, "SMB connection was closed during read\n");
+            return libsmbc_abort_async_read(libsmbc, parts, AVERROR(ENOTCONN));
+        }
+
+        poll_result = poll(&descriptor, 1, 1000);
+        if (poll_result < 0) {
+            if (errno == EINTR)
+                continue;
+            av_log(h, AV_LOG_ERROR, "SMB read poll failed: %s\n", strerror(errno));
+            return libsmbc_abort_async_read(libsmbc, parts, AVERROR(errno));
+        }
+        if (poll_result == 0) {
+            if (++idle_seconds < 30)
+                continue;
+            av_log(h, AV_LOG_ERROR, "SMB read timed out\n");
+            return libsmbc_abort_async_read(libsmbc, parts, AVERROR(ETIMEDOUT));
+        }
+
+        idle_seconds = 0;
+        service_result = smb2_service(libsmbc->smb2, descriptor.revents);
+        if (service_result < 0) {
+            av_log(h, AV_LOG_ERROR, "SMB read service failed: %s\n",
+                   smb2_get_error(libsmbc->smb2));
+            return libsmbc_abort_async_read(libsmbc, parts, AVERROR(EIO));
+        }
+    }
+
+    for (int index = 0; index < scheduled; index++) {
+        if (parts[index].status < 0) {
+            if (!total)
+                total = parts[index].status;
+            break;
+        }
+        total += parts[index].status;
+        if ((uint32_t)parts[index].status < parts[index].requested)
+            break;
+    }
+    av_free(parts);
+
+    if (scheduling_error < 0 && total <= 0)
+        return scheduling_error;
+    return total;
+}
+
+static int libsmbc_parallel_pread(URLContext *h, unsigned char *buf, int size,
+                                  int64_t offset)
+{
+    LIBSMBContext *libsmbc = h->priv_data;
+    LIBSMBParallelReadTask tasks[LIBSMB_MAX_CONNECTIONS] = {0};
+    pthread_t threads[LIBSMB_MAX_CONNECTIONS - 1];
+    int thread_started[LIBSMB_MAX_CONNECTIONS] = {0};
+    int connections = 0;
+    int total = 0;
+
+    if (libsmbc->smb2 && libsmbc->fh) {
+        tasks[connections].smb2 = libsmbc->smb2;
+        tasks[connections].fh = libsmbc->fh;
+        connections++;
+    }
+    for (int index = 0; index < LIBSMB_MAX_CONNECTIONS - 1; index++) {
+        if (!libsmbc->aux_smb2[index] || !libsmbc->aux_fh[index])
+            continue;
+        tasks[connections].smb2 = libsmbc->aux_smb2[index];
+        tasks[connections].fh = libsmbc->aux_fh[index];
+        connections++;
+    }
+
+    if (connections <= 1)
+        return libsmbc_pipelined_pread(h, buf, size, offset);
+
+    int chunk_size = (size + connections - 1) / connections;
+    int task_count = 0;
+    for (int index = 0; index < connections; index++) {
+        int task_offset = index * chunk_size;
+        if (task_offset >= size)
+            break;
+        tasks[index].buffer = buf + task_offset;
+        tasks[index].size = FFMIN(chunk_size, size - task_offset);
+        tasks[index].offset = offset + task_offset;
+        task_count++;
+    }
+
+    for (int index = 1; index < task_count; index++) {
+        if (pthread_create(&threads[index - 1], NULL,
+                           libsmbc_parallel_read_worker, &tasks[index]) == 0)
+            thread_started[index] = 1;
+    }
+
+    libsmbc_parallel_read_worker(&tasks[0]);
+    for (int index = 1; index < task_count; index++) {
+        if (thread_started[index])
+            pthread_join(threads[index - 1], NULL);
+        else
+            libsmbc_parallel_read_worker(&tasks[index]);
+    }
+
+    for (int index = 0; index < task_count; index++) {
+        if (tasks[index].result < 0)
+            return total ? total : tasks[index].result;
+        total += tasks[index].result;
+        if ((uint32_t)tasks[index].result < tasks[index].size)
+            break;
+    }
+    return total;
+}
+
+/* whitespace characters considered (same as http.c's WHITESPACES) */
+#define WHITESPACES " \n\t\r"
+
+/* trim leading whitespace in-place, return pointer to first non-space */
+static char *trim_leading(char *s)
+{
+    if (!s) return s;
+    while (*s && strchr(WHITESPACES, *s)) s++;
+    return s;
+}
+
+/* trim trailing whitespace in-place (modifies string), return s */
+static char *trim_trailing(char *s)
+{
+    char *end;
+    if (!s || !*s) return s;
+    end = s + strlen(s) - 1;
+    while (end >= s && strchr(WHITESPACES, *end)) {
+        *end = '\0';
+        end--;
+    }
+    return s;
+}
+
+/*
+ * Parse a headers block (possibly multiline) into dict.
+ * headers: input string, may contain CRLF or LF separated header lines.
+ * dict: pointer to AVDictionary* (may be NULL initially). On success the
+ *       dictionary will contain header key->value pairs.
+ *
+ * Returns 0 on success, negative AVERROR on OOM.
+ */
+static int ff_headers_to_dict(const char *headers, AVDictionary **dict) {
+    char *tmp = NULL;
+    char *line = NULL;
+    char *saveptr = NULL;
+    int ret = 0;
+
+    if (!headers)
+        return 0;
+
+    /* duplicate because av_strtok modifies the string */
+    tmp = av_strdup(headers);
+    if (!tmp)
+        return AVERROR(ENOMEM);
+
+    /* Split into lines by '\n' (this will leave CR if present at end; we trim) */
+    line = av_strtok(tmp, "\n", &saveptr);
+    while (line) {
+        char *key = NULL;
+        char *value = NULL;
+        char *valptr = NULL;
+
+        /* strip leading/trailing whitespace from the line first */
+        line = trim_leading(line);
+        trim_trailing(line);
+
+        if (!*line) {
+            /* empty line, skip */
+            line = av_strtok(NULL, "\n", &saveptr);
+            continue;
+        }
+
+        /* We want to split at the FIRST ':' so that values containing ':' are preserved.
+         * av_strtok with ":" returns the token before the first ':' and sets
+         * the remainder pointer (valptr) to the rest of the string.
+         *
+         * Use a copy of line because av_strtok will modify it and we might
+         * want to avoid modifying the original duplicated buffer layout,
+         * but here modifying tmp is fine so we can operate on line directly.
+         */
+        key = av_strtok(line, ":", &valptr);
+        if (!key) {
+            /* malformed line, skip */
+            line = av_strtok(NULL, "\n", &saveptr);
+            continue;
+        }
+
+        /* valptr points to the remainder after the first ':'. It may be NULL
+         * if no colon found (but av_strtok would have returned entire line then).
+         * We'll treat missing value as empty string.
+         */
+        if (valptr)
+            value = valptr;
+        else
+            value = line + strlen(line);;
+
+        /* trim spaces around key and value */
+        key = trim_leading(key);
+        trim_trailing(key);
+
+        value = trim_leading(value);
+        trim_trailing(value);
+
+        /* At this point key and value are trimmed and ready.
+         * Use av_dict_set to put them into dict. 0 flags => dict will dup key/value.
+         */
+        ret = av_dict_set(dict, key, value, 0);
+        if (ret < 0) {
+            av_free(tmp);
+            return ret; /* likely OOM */
+        }
+
+        /* next line */
+        line = av_strtok(NULL, "\n", &saveptr);
+    }
+
+    av_free(tmp);
+    return 0;
+}
+
+static av_cold int libsmbc_connect(URLContext *h, const char *url) {
+    LIBSMBContext *libsmbc = h->priv_data;
+
+    libsmbc->smb2 = smb2_init_context();
+    if (libsmbc->smb2 == NULL) {
+        int ret = AVERROR(errno);
+        av_log(h, AV_LOG_ERROR, "Failed to init context\n");
+        return ret;
+    }
+
+    smb2_set_timeout(libsmbc->smb2, 30);
+    smb2_set_password(libsmbc->smb2, libsmbc->auth ? libsmbc->auth : "");
+    smb2_set_security_mode(libsmbc->smb2, SMB2_NEGOTIATE_SIGNING_ENABLED);
+
+    libsmbc->url = smb2_parse_url(libsmbc->smb2, url);
+    if (libsmbc->url == NULL) {
+        int ret = AVERROR(errno);
+        av_log(h, AV_LOG_ERROR, "Failed to parse url\n");
+        return ret;
+    }
+
+    libsmbc->decoded_share = ff_urldecode(
+        libsmbc->url->share ? libsmbc->url->share : "", 0);
+    libsmbc->decoded_path = ff_urldecode(
+        libsmbc->url->path ? libsmbc->url->path : "", 0);
+    libsmbc->decoded_user = ff_urldecode(
+        libsmbc->url->user ? libsmbc->url->user : "", 0);
+    if (!libsmbc->decoded_share || !libsmbc->decoded_path ||
+        !libsmbc->decoded_user)
+        return AVERROR(ENOMEM);
+
+    if (smb2_connect_share(libsmbc->smb2, libsmbc->url->server,
+                           libsmbc->decoded_share,
+                           libsmbc->decoded_user) != 0) {
+        int ret = AVERROR(errno);
+        av_log(h, AV_LOG_ERROR, "smb2_connect_share failed. %s\n", smb2_get_error(libsmbc->smb2));
+        return ret;
+    }
+    libsmbc->connected = 1;
+
+    return 0;
+}
+
+static av_cold int libsmbc_close(URLContext *h) {
+    LIBSMBContext *libsmbc = h->priv_data;
+    if (libsmbc->prefetch_count > 0) {
+        av_log(h, AV_LOG_INFO,
+               "SMB read-ahead stats: delivered=%lld fetched=%lld prefetches=%d\n",
+               (long long)libsmbc->delivered_bytes,
+               (long long)libsmbc->fetched_bytes, libsmbc->prefetch_count);
+    }
+    av_freep(&libsmbc->read_buffer);
+    libsmbc->read_buffer_valid = 0;
+    for (int index = 0; index < LIBSMB_MAX_CONNECTIONS - 1; index++) {
+        libsmbc_close_connection(&libsmbc->aux_smb2[index],
+                                 &libsmbc->aux_fh[index],
+                                 &libsmbc->aux_url[index], 1);
+    }
+    if (libsmbc->fh && libsmbc->smb2) {
+        smb2_close(libsmbc->smb2, libsmbc->fh);
+        libsmbc->fh = NULL;
+    }
+    if (libsmbc->url) {
+        smb2_destroy_url(libsmbc->url);
+        libsmbc->url = NULL;
+    }
+    av_freep(&libsmbc->decoded_share);
+    av_freep(&libsmbc->decoded_path);
+    av_freep(&libsmbc->decoded_user);
+    if (libsmbc->auth) {
+        av_freep(&libsmbc->auth);
+    }
+
+    if (libsmbc->smb2) {
+        if (libsmbc->connected)
+            smb2_disconnect_share(libsmbc->smb2);
+        smb2_destroy_context(libsmbc->smb2);
+        libsmbc->smb2 = NULL;
+        libsmbc->connected = 0;
+    }
+    return 0;
+}
+
+static av_cold int libsmbc_open(URLContext *h, const char *url, int flags,
+                     AVDictionary **options) {
+    LIBSMBContext *libsmbc = h->priv_data;
+    LIBSMBOpenTask open_tasks[LIBSMB_MAX_CONNECTIONS - 1] = {0};
+    pthread_t open_threads[LIBSMB_MAX_CONNECTIONS - 1];
+    int open_thread_started[LIBSMB_MAX_CONNECTIONS - 1] = {0};
+    int ret;
+    struct smb2_stat_64 st;
+    libsmbc->filesize = -1;
+    libsmbc->connected = 0;
+    libsmbc->position = 0;
+    libsmbc->read_buffer_start = -1;
+    libsmbc->read_buffer_valid = 0;
+    libsmbc->delivered_bytes = 0;
+    libsmbc->fetched_bytes = 0;
+    libsmbc->prefetch_count = 0;
+
+   AVDictionary *headers_dict = NULL;
+   AVDictionaryEntry *e;
+   if (!libsmbc->auth && *options) {
+       e = av_dict_get(*options, "headers", NULL, 0);
+       if (e && e->value) {
+           if (ff_headers_to_dict(e->value, &headers_dict) < 0) {
+               av_log(h, AV_LOG_ERROR, "smb: failed to parse headers into dict\n");
+           } else {
+               AVDictionaryEntry *pw = av_dict_get(headers_dict, "Authorization", NULL, AV_DICT_MATCH_CASE);
+               if (pw) {
+                   av_freep(&libsmbc->auth);
+                   libsmbc->auth = av_strdup(pw->value);
+               }
+            }
+        }
+    }
+    av_dict_free(&headers_dict);
+
+    if ((ret = libsmbc_connect(h, url)) < 0) goto fail;
+
+    libsmbc->fh = smb2_open(libsmbc->smb2, libsmbc->decoded_path, O_RDONLY);
+    if (libsmbc->fh == NULL) {
+        ret = AVERROR(EIO);
+        av_log(h, AV_LOG_ERROR, "File open failed: %s\n",
+               smb2_get_error(libsmbc->smb2));
+        goto fail;
+    }
+
+    for (int index = 0; index < LIBSMB_MAX_CONNECTIONS - 1; index++) {
+        open_tasks[index].url = url;
+        open_tasks[index].auth = libsmbc->auth;
+        if (pthread_create(&open_threads[index], NULL, libsmbc_open_worker,
+                           &open_tasks[index]) == 0)
+            open_thread_started[index] = 1;
+    }
+    for (int index = 0; index < LIBSMB_MAX_CONNECTIONS - 1; index++) {
+        if (open_thread_started[index])
+            pthread_join(open_threads[index], NULL);
+        else
+            libsmbc_open_worker(&open_tasks[index]);
+        if (open_tasks[index].result < 0)
+            continue;
+        libsmbc->aux_smb2[index] = open_tasks[index].smb2;
+        libsmbc->aux_fh[index] = open_tasks[index].fh;
+        libsmbc->aux_url[index] = open_tasks[index].parsed_url;
+    }
+
+    if (smb2_stat(libsmbc->smb2, libsmbc->decoded_path, &st) < 0) {
+        av_log(h, AV_LOG_WARNING, "Cannot stat file: %s\n",
+               smb2_get_error(libsmbc->smb2));
+    } else {
+        libsmbc->filesize = st.smb2_size;
+    }
+
+    libsmbc->read_buffer = av_malloc(libsmbc->read_buffer_size);
+    if (!libsmbc->read_buffer) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    av_log(h, AV_LOG_INFO,
+           "SMB read-ahead enabled: buffer=%d max-request=%u dialect=0x%04x sessions=%d\n",
+           libsmbc->read_buffer_size,
+           smb2_get_max_read_size(libsmbc->smb2),
+           smb2_get_dialect(libsmbc->smb2),
+           1 + !!libsmbc->aux_smb2[0] + !!libsmbc->aux_smb2[1] +
+           !!libsmbc->aux_smb2[2]);
+
+    return 0;
+fail:
+    libsmbc_close(h);
+    return ret;
+}
+
+static int64_t libsmbc_seek(URLContext *h, int64_t pos, int whence) {
+    LIBSMBContext *libsmbc = h->priv_data;
+    int64_t newpos;
+
+    if (whence == AVSEEK_SIZE) {
+        if (libsmbc->filesize == -1) {
+            av_log(h, AV_LOG_ERROR, "Error during seeking: filesize is unknown.\n");
+            return AVERROR(EIO);
+        } else
+            return libsmbc->filesize;
+    }
+
+    switch (whence) {
+    case SEEK_SET:
+        newpos = pos;
+        break;
+    case SEEK_CUR:
+        if ((pos > 0 && libsmbc->position > INT64_MAX - pos) ||
+            (pos < 0 && libsmbc->position < INT64_MIN - pos))
+            return AVERROR(EINVAL);
+        newpos = libsmbc->position + pos;
+        break;
+    case SEEK_END:
+        if (libsmbc->filesize < 0 ||
+            (pos > 0 && libsmbc->filesize > INT64_MAX - pos) ||
+            (pos < 0 && libsmbc->filesize < INT64_MIN - pos))
+            return AVERROR(EINVAL);
+        newpos = libsmbc->filesize + pos;
+        break;
+    default:
+        return AVERROR(EINVAL);
+    }
+
+    if (newpos < 0)
+        return AVERROR(EINVAL);
+
+    libsmbc->position = newpos;
+
+    return newpos;
+}
+
+static int libsmbc_read(URLContext *h, unsigned char *buf, int size) {
+    LIBSMBContext *libsmbc = h->priv_data;
+    int total = 0;
+
+    if (size <= 0)
+        return 0;
+    if (libsmbc->filesize >= 0 && libsmbc->position >= libsmbc->filesize)
+        return AVERROR_EOF;
+
+    while (total < size) {
+        int64_t buffer_end = libsmbc->read_buffer_start + libsmbc->read_buffer_valid;
+
+        if (libsmbc->read_buffer_valid > 0 &&
+            libsmbc->position >= libsmbc->read_buffer_start &&
+            libsmbc->position < buffer_end) {
+            int buffer_offset = libsmbc->position - libsmbc->read_buffer_start;
+            int copy_size = FFMIN(size - total,
+                                  libsmbc->read_buffer_valid - buffer_offset);
+
+            memcpy(buf + total, libsmbc->read_buffer + buffer_offset, copy_size);
+            libsmbc->position += copy_size;
+            libsmbc->delivered_bytes += copy_size;
+            total += copy_size;
+            continue;
+        }
+
+        int fill_size = libsmbc->read_buffer_size;
+        int bytes_read;
+
+        if (libsmbc->filesize >= 0)
+            fill_size = FFMIN((int64_t)fill_size,
+                              libsmbc->filesize - libsmbc->position);
+        if (fill_size <= 0)
+            break;
+
+        bytes_read = libsmbc_parallel_pread(h, libsmbc->read_buffer,
+                                            fill_size, libsmbc->position);
+        if (bytes_read < 0) {
+            const char *error = libsmbc->smb2
+                              ? smb2_get_error(libsmbc->smb2)
+                              : "connection closed";
+            av_log(h, AV_LOG_ERROR, "SMB read failed: %s\n", error);
+            return total ? total : bytes_read;
+        }
+        if (!bytes_read)
+            break;
+
+        libsmbc->fetched_bytes += bytes_read;
+        libsmbc->prefetch_count++;
+        libsmbc->read_buffer_start = libsmbc->position;
+        libsmbc->read_buffer_valid = bytes_read;
+    }
+
+    return total ? total : AVERROR_EOF;
+}
+
+static int libsmbc_write(URLContext *h, const unsigned char *buf, int size) {
+    LIBSMBContext *libsmbc = h->priv_data;
+    int bytes_written;
+
+    if ((bytes_written = smb2_write(libsmbc->smb2, libsmbc->fh, buf, size)) < 0) {
+        int ret = AVERROR(errno);
+        av_log(h, AV_LOG_ERROR, "Write error: %s\n", strerror(errno));
+        return ret;
+    }
+
+    return bytes_written;
+}
+
+static int libsmbc_open_dir(URLContext *h) {
+    LIBSMBContext *libsmbc = h->priv_data;
+    int ret;
+
+    if ((ret = libsmbc_connect(h, h->filename)) < 0) goto fail;
+
+    libsmbc->dir = smb2_opendir(libsmbc->smb2, libsmbc->decoded_path);
+    if (libsmbc->dir == NULL) {
+        ret = AVERROR(EIO);
+        av_log(h, AV_LOG_ERROR, "Dir open failed: %s\n",
+               smb2_get_error(libsmbc->smb2));
+        goto fail;
+    }
+
+    return 0;
+fail:
+    libsmbc_close(h);
+    return ret;
+}
+
+static int libsmbc_read_dir(URLContext *h, AVIODirEntry **next) {
+    LIBSMBContext *libsmbc = h->priv_data;
+    AVIODirEntry *entry;
+    struct smb2dirent *dirent;
+    int skip_entry;
+
+    *next = entry = ff_alloc_dir_entry();
+    if (!entry) return AVERROR(ENOMEM);
+
+    do {
+        skip_entry = 0;
+        dirent = smb2_readdir(libsmbc->smb2, libsmbc->dir);
+        if (dirent == NULL) {
+            av_freep(next);
+            return AVERROR(errno);
+        }
+        switch (dirent->st.smb2_type) {
+        case SMB2_TYPE_FILE:
+            entry->type = AVIO_ENTRY_FILE;
+            break;
+        case SMB2_TYPE_DIRECTORY:
+            entry->type = AVIO_ENTRY_DIRECTORY;
+            break;
+        case SMB2_TYPE_LINK:
+            entry->type = AVIO_ENTRY_SYMBOLIC_LINK;
+            break;
+        default:
+            skip_entry = 1;
+        }
+    } while (skip_entry || !strcmp(dirent->name, ".") || !strcmp(dirent->name, ".."));
+
+    entry->name = av_strdup(dirent->name);
+    entry->size = dirent->st.smb2_size;
+    entry->modification_timestamp = dirent->st.smb2_mtime;
+    entry->access_timestamp = dirent->st.smb2_atime;
+    entry->status_change_timestamp = dirent->st.smb2_ctime;
+
+    return 0;
+}
+
+static int libsmbc_close_dir(URLContext *h) {
+    LIBSMBContext *libsmbc = h->priv_data;
+    if (libsmbc->dir) {
+        smb2_closedir(libsmbc->smb2, libsmbc->dir);
+        libsmbc->dir = NULL;
+    }
+    libsmbc_close(h);
+    return 0;
+}
+
+static int libsmbc_delete(URLContext *h) { return AVERROR(EPERM); }
+
+static int libsmbc_move(URLContext *h_src, URLContext *h_dst) { return AVERROR(EPERM); }
+
+#define OFFSET(x) offsetof(LIBSMBContext, x)
+#define D AV_OPT_FLAG_DECODING_PARAM
+#define E AV_OPT_FLAG_ENCODING_PARAM
+static const AVOption options[] = {
+    {"timeout", "set timeout in ms of socket I/O operations", OFFSET(timeout), AV_OPT_TYPE_INT, {.i64 = -1}, -1, INT_MAX, D | E},
+    {"truncate", "truncate existing files on write", OFFSET(trunc), AV_OPT_TYPE_INT, {.i64 = 1}, 0, 1, E},
+    {"workgroup", "set the workgroup used for making connections", OFFSET(workgroup), AV_OPT_TYPE_STRING, {0}, 0, 0, D | E},
+    {"auth", "SMB auth (can be passed from mpv)", OFFSET(auth), AV_OPT_TYPE_STRING, { .str = NULL }, 0, 0, AV_OPT_FLAG_DECODING_PARAM},
+    {"read_ahead", "SMB parallel read-ahead size", OFFSET(read_buffer_size), AV_OPT_TYPE_INT, {.i64 = 4 * 1024 * 1024}, 1024 * 1024, 16 * 1024 * 1024, D},
+    {NULL}
+};
+
+static const AVClass libsmb2_context_class = {
+    .class_name = "libsmb2",
+    .item_name = av_default_item_name,
+    .option = options,
+    .version = LIBAVUTIL_VERSION_INT,
+};
+
+const URLProtocol ff_libsmb2_protocol = {
+    .name = "smb",
+    .url_open2 = libsmbc_open,
+    .url_read = libsmbc_read,
+    .url_write = libsmbc_write,
+    .url_seek = libsmbc_seek,
+    .url_close = libsmbc_close,
+    .url_delete = libsmbc_delete,
+    .url_move = libsmbc_move,
+    .url_open_dir = libsmbc_open_dir,
+    .url_read_dir = libsmbc_read_dir,
+    .url_close_dir = libsmbc_close_dir,
+    .priv_data_size = sizeof(LIBSMBContext),
+    .priv_data_class = &libsmb2_context_class,
+    .flags = URL_PROTOCOL_FLAG_NETWORK,
+};
