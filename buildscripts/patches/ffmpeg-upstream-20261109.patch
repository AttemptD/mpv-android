+static int mediacodec_receive_output(AVCodecContext *avctx,
+                                     MediaCodecH264DecContext *s,
+                                     AVFrame *frame, bool wait)
+{
+    int ret = ff_mediacodec_dec_receive(avctx, s->ctx, frame, wait);
+    if (ret >= 0 && s->native_hdr_output && avctx->color_trc != s->native_hdr_output) {
+        av_log(avctx, AV_LOG_ERROR, "Native HDR decoder changed the requested transfer\n");
+        av_frame_unref(frame);
+        return AVERROR_EXTERNAL;
+    }
+
+#if CONFIG_HEVC_MEDIACODEC_DECODER
+    if (ret >= 0 && avctx->codec_id == AV_CODEC_ID_HEVC && !s->native_hdr_output) {
+        ret = mediacodec_dovi_attach(avctx, s, frame);
+        if (ret < 0)
+            av_frame_unref(frame);
+    }
+#endif
+
+    return ret;
+}
