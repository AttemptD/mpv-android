 } MediaCodecH264DecContext;
 
+#if CONFIG_HEVC_MEDIACODEC_DECODER
+static int64_t mediacodec_pts_to_us(const AVCodecContext *avctx, int64_t pts)
+{
+    /* Keep this exactly in sync with ff_mediacodec_dec_send(). */
+    if (pts == AV_NOPTS_VALUE)
+        return 0;
+    if (pts && avctx->pkt_timebase.num && avctx->pkt_timebase.den)
+        return av_rescale_q(pts, avctx->pkt_timebase, AV_TIME_BASE_Q);
+    return pts;
+}
+
+static void mediacodec_dovi_frame_unref(MediaCodecDoviFrame *frame)
+{
+    av_buffer_unref(&frame->metadata);
+    av_buffer_unref(&frame->rpu);
+}
+
+static void mediacodec_dovi_flush(MediaCodecH264DecContext *s)
+{
+    for (int i = 0; i < s->nb_dovi_frames; i++)
+        mediacodec_dovi_frame_unref(&s->dovi_frames[i]);
+    av_freep(&s->dovi_frames);
+    s->nb_dovi_frames = 0;
+    ff_dovi_ctx_flush(&s->dovi_ctx);
+}
+
+static void mediacodec_dovi_update_config(AVCodecContext *avctx,
+                                          MediaCodecH264DecContext *s,
+                                          const AVPacket *pkt)
+{
+    const uint8_t *data = NULL;
+    size_t size = 0;
+
+    if (pkt)
+        data = av_packet_get_side_data(pkt, AV_PKT_DATA_DOVI_CONF, &size);
+    if (!data) {
+        const AVPacketSideData *sd =
+            ff_get_coded_side_data(avctx, AV_PKT_DATA_DOVI_CONF);
+        if (sd) {
+            data = sd->data;
+            size = sd->size;
+        }
+    }
+
+    if (data && size >= sizeof(s->dovi_ctx.cfg))
+        memcpy(&s->dovi_ctx.cfg, data, sizeof(s->dovi_ctx.cfg));
+}
+
+static int mediacodec_dovi_queue(MediaCodecH264DecContext *s,
+                                 AVCodecContext *avctx, const AVPacket *pkt,
+                                 const H2645NAL *nal)
+{
+    AVDOVIMetadata *metadata = NULL;
+    MediaCodecDoviFrame frame = { .pts_us = mediacodec_pts_to_us(avctx, pkt->pts) };
+    MediaCodecDoviFrame *frames;
+    int metadata_size;
+    int ret;
+
+    ret = ff_dovi_rpu_parse(&s->dovi_ctx, nal->data + 2, nal->size - 2,
+                            avctx->err_recognition);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_WARNING,
+               "Failed parsing Dolby Vision RPU for MediaCodec frame\n");
+        return 0; /* Metadata failure must not disable hardware decoding. */
+    }
+
+    metadata_size = ff_dovi_get_metadata(&s->dovi_ctx, &metadata);
+    if (metadata_size < 0)
+        return metadata_size;
+    if (!metadata_size)
+        return 0;
+
+    frame.metadata = av_buffer_create((uint8_t *)metadata, metadata_size,
+                                      NULL, NULL, 0);
+    if (!frame.metadata) {
+        av_free(metadata);
+        return AVERROR(ENOMEM);
+    }
+
+    if (nal->raw_size > 2) {
+        frame.rpu = av_buffer_alloc(nal->raw_size - 2);
+        if (!frame.rpu) {
+            mediacodec_dovi_frame_unref(&frame);
+            return AVERROR(ENOMEM);
+        }
+        memcpy(frame.rpu->data, nal->raw_data + 2, nal->raw_size - 2);
+    }
+
+    if (s->nb_dovi_frames >= MEDIACODEC_DOVI_MAX_QUEUED) {
+        av_log(avctx, AV_LOG_WARNING,
+               "MediaCodec Dolby Vision metadata queue overflow; dropping oldest RPU\n");
+        mediacodec_dovi_frame_unref(&s->dovi_frames[0]);
+        memmove(&s->dovi_frames[0], &s->dovi_frames[1],
+                (s->nb_dovi_frames - 1) * sizeof(*s->dovi_frames));
+        s->nb_dovi_frames--;
+    }
+
+    frames = av_realloc_array(s->dovi_frames, s->nb_dovi_frames + 1,
+                              sizeof(*s->dovi_frames));
+    if (!frames) {
+        mediacodec_dovi_frame_unref(&frame);
+        return AVERROR(ENOMEM);
+    }
+    s->dovi_frames = frames;
+    s->dovi_frames[s->nb_dovi_frames++] = frame;
+
+    av_log(avctx, AV_LOG_TRACE,
+           "Queued Dolby Vision RPU for MediaCodec pts=%"PRId64"\n",
+           frame.pts_us);
+    return 0;
+}
+
+static int mediacodec_dovi_parse_packet(AVCodecContext *avctx,
+                                        MediaCodecH264DecContext *s,
+                                        const AVPacket *pkt)
+{
+    int ret;
+
+    if (avctx->codec_id != AV_CODEC_ID_HEVC || !pkt->size)
+        return 0;
+
+    mediacodec_dovi_update_config(avctx, s, pkt);
+    ret = ff_h2645_packet_split(&s->dovi_pkt, pkt->data, pkt->size, avctx, 4,
+                                AV_CODEC_ID_HEVC, H2645_FLAG_SMALL_PADDING);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_WARNING,
+               "Failed splitting HEVC packet for Dolby Vision side parsing\n");
+        return 0;
+    }
+
+    for (int i = 0; i < s->dovi_pkt.nb_nals; i++) {
+        const H2645NAL *nal = &s->dovi_pkt.nals[i];
+        if (nal->type != HEVC_NAL_UNSPEC62 || nal->size <= 2 ||
+            nal->nuh_layer_id || nal->temporal_id)
+            continue;
+        ret = mediacodec_dovi_queue(s, avctx, pkt, nal);
+        if (ret < 0)
+            return ret;
+    }
+
+    return 0;
+}
+
+static int mediacodec_dovi_attach(AVCodecContext *avctx,
+                                  MediaCodecH264DecContext *s,
+                                  AVFrame *frame)
+{
+    int64_t pts_us = mediacodec_pts_to_us(avctx, frame->pts);
+    int match = -1;
+
+    if (frame->format == AV_PIX_FMT_MEDIACODEC && frame->data[3])
+        pts_us = ((MediaCodecBuffer *)frame->data[3])->pts;
+
+    for (int i = 0; i < s->nb_dovi_frames; i++) {
+        if (s->dovi_frames[i].pts_us == pts_us) {
+            match = i;
+            break;
+        }
+    }
+    if (match < 0)
+        return 0;
+
+    MediaCodecDoviFrame metadata = s->dovi_frames[match];
+    memmove(&s->dovi_frames[match], &s->dovi_frames[match + 1],
+            (s->nb_dovi_frames - match - 1) * sizeof(*s->dovi_frames));
+    s->nb_dovi_frames--;
+
+    if (metadata.metadata) {
+        AVFrameSideData *sd = av_frame_new_side_data_from_buf(
+            frame, AV_FRAME_DATA_DOVI_METADATA, metadata.metadata);
+        if (!sd) {
+            av_buffer_unref(&metadata.metadata);
+            av_buffer_unref(&metadata.rpu);
+            return AVERROR(ENOMEM);
+        }
+        metadata.metadata = NULL;
+    }
+    if (metadata.rpu) {
+        AVFrameSideData *sd = av_frame_new_side_data_from_buf(
+            frame, AV_FRAME_DATA_DOVI_RPU_BUFFER, metadata.rpu);
+        if (!sd) {
+            av_buffer_unref(&metadata.rpu);
+            return AVERROR(ENOMEM);
+        }
+        metadata.rpu = NULL;
+    }
+
+    if (!s->dovi_metadata_logged) {
+        av_log(avctx, AV_LOG_INFO,
+               "Dolby Vision RPU side data active for MediaCodec output\n");
+        s->dovi_metadata_logged = 1;
+    }
+    av_log(avctx, AV_LOG_TRACE,
+           "Attached Dolby Vision RPU to MediaCodec frame pts=%"PRId64"\n",
+           pts_us);
+    return 0;
+}
+#endif
