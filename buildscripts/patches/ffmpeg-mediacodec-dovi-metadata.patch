--- a/libavcodec/mediacodecdec.c
+++ b/libavcodec/mediacodecdec.c
@@ -36,8 +36,11 @@
 #include "avcodec.h"
 #include "codec_internal.h"
 #include "decode.h"
+#include "dovi_rpu.h"
+#include "h2645_parse.h"
 #include "h264_parse.h"
