+    && defined(MBEDTLS_HAVE_NEON_INTRINSICS) \
     && (defined(MBEDTLS_COMPILER_IS_GCC) || defined(__clang__) || defined(MSC_VER))
 
 /* MBEDTLS_AESCE_HAVE_CODE is defined if we have a suitable target platform, and a
@@ -33,7 +39,21 @@
 extern "C" {
 #endif
 
-#if defined(__linux__) && !defined(MBEDTLS_AES_USE_HARDWARE_ONLY)
+#if defined(MBEDTLS_AESCE_ANDROID_ARM32)
+#include <stdatomic.h>
+
+extern atomic_int mbedtls_aesce_android_arm32_support;
+int mbedtls_aesce_has_support_impl(void);
+
+static inline int mbedtls_aesce_android_arm32_has_support(void)
+{
+    int supported = atomic_load_explicit(&mbedtls_aesce_android_arm32_support,
+                                         memory_order_relaxed);
+    return supported >= 0 ? supported : mbedtls_aesce_has_support_impl();
+}
+
+#define MBEDTLS_AESCE_HAS_SUPPORT() mbedtls_aesce_android_arm32_has_support()
+#elif defined(__linux__) && !defined(MBEDTLS_AES_USE_HARDWARE_ONLY)
 
 extern signed char mbedtls_aesce_has_support_result;
 
