diff --git a/library/Makefile b/library/Makefile
--- a/library/Makefile
+++ b/library/Makefile
@@ -34,6 +34,13 @@
 # under /3rdparty).
 LOCAL_CFLAGS = $(WARNING_CFLAGS) -I. -I../include -D_FILE_OFFSET_BITS=64
 LOCAL_LDFLAGS =
+
+# Keep the 32-bit Android library compatible with Armv7. Only the translation
+# unit reached after the runtime crypto feature check may use Armv8 instructions.
+ifdef MBEDTLS_ANDROID_ARM32_AESCE
+LOCAL_CFLAGS += -DMBEDTLS_ANDROID_ARM32_AESCE
+aesce.o: LOCAL_CFLAGS += -march=armv8-a+crypto
+endif
 
 ifdef DEBUG
 LOCAL_CFLAGS += -g3
diff --git a/library/aes.c b/library/aes.c
--- a/library/aes.c
+++ b/library/aes.c
@@ -50,6 +50,25 @@
 #endif
 #if defined(MBEDTLS_AESCE_C)
 #include "aesce.h"
+#endif
+
+#if defined(MBEDTLS_AESCE_HAVE_CODE) && defined(MBEDTLS_AESCE_ANDROID_ARM32)
+#include <asm/hwcap.h>
+#include <sys/auxv.h>
+
+atomic_int mbedtls_aesce_android_arm32_support = -1;
+
+/* This runs in the baseline Armv7 translation unit on every supported CPU.
+ * GCM uses polynomial multiplication as well as the AES instructions. */
+int mbedtls_aesce_has_support_impl(void)
+{
+    const unsigned long required = HWCAP2_AES | HWCAP2_PMULL;
+    int supported = (getauxval(AT_HWCAP) & HWCAP_NEON) != 0 &&
+                    (getauxval(AT_HWCAP2) & required) == required;
+    atomic_store_explicit(&mbedtls_aesce_android_arm32_support, supported,
+                          memory_order_relaxed);
+    return supported;
+}
 #endif
 
 #include "mbedtls/platform.h"
diff --git a/library/aesce.c b/library/aesce.c
--- a/library/aesce.c
+++ b/library/aesce.c
